# Supabase — copie este arquivo para .env e preencha com suas credenciais
# Obtenha em: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Variáveis de servidor (Vercel Serverless Functions)
# NUNCA exponha estas chaves no frontend (sem prefixo VITE_)
# Configure apenas em Vercel Dashboard → Settings → Environment Variables

# Supabase Service Role (APENAS servidor, bypassa RLS)
# Obtenha em: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# OneSignal (notificações push)
# Obtenha em: https://onesignal.com/dashboard → Settings → Keys & IDs
ONESIGNAL_APP_ID=seu_app_id_aqui
ONESIGNAL_REST_API_KEY=sua_rest_api_key_aqui
